#!/bin/bash
#
# post-commit hook — incremental graphify update after every commit
#
# Keeps graphify-out/ in sync automatically.
# Runs best-effort: failures are logged but do not block anything.
#
# Install:
#   git config core.hooksPath .githooks
#   chmod +x .githooks/post-commit
#

set -euo pipefail

# Only update when graphify artifacts already exist
if [ ! -f "graphify-out/graph.json" ]; then
    echo "[graphify] graphify-out/ not found — skipping update. Run 'graphify .' first."
    exit 0
fi

# Run from repo root
if command -v graphify >/dev/null 2>&1; then
    if graphify update . >/dev/null 2>&1; then
        echo "[graphify] Updated after commit."
    else
        echo "[graphify] WARNING: update failed." >&2
    fi
else
    echo "[graphify] WARNING: 'graphify' not in PATH — skipping." >&2
fi

exit 0
