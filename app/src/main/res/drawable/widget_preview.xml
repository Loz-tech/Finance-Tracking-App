<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Widget background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF021A54" />
            <corners android:radius="16dp" />
            <size android:width="64dp" android:height="68dp" />
        </shape>
    </item>

    <!-- Single icon slot -->
    <item
        android:left="8dp"
        android:top="10dp"
        android:right="8dp"
        android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#25FFFFFF" />
        </shape>
    </item>
</layer-list>