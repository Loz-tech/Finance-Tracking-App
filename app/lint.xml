<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- Treat NewApi as fatal: blocks any usage of APIs above minSdk without desugaring/compat -->
    <issue id="NewApi" severity="fatal" />

    <!-- Treat UnusedAttribute (API-gated XML attributes) as error -->
    <issue id="UnusedAttribute" severity="error" />

    <!-- 4. Remove unused code -->
    <issue id="UnusedResources" severity="error" />
    <issue id="UnusedIds" severity="error" />

    <!-- 5. Flag deprecated APIs so developers must provide workarounds -->
    <issue id="Deprecation" severity="warning" />

    <!-- 6. Enforce resources for literal strings and icon names -->
    <issue id="HardcodedText" severity="warning" />
    <issue id="IconDensities" severity="warning" />
    <issue id="IconExpectedSize" severity="warning" />

    <!-- Suppress noisy/informational warnings that are not actionable in CI -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="OldTargetApi" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="MonochromeLauncherIcon" severity="ignore" />
    <issue id="DefaultLocale" severity="error" />
</lint>
